+    const joiner = text && piece ? ' ' : '';
+    const offset = text.length + joiner.length;
+    if (joiner) text += joiner;
+    for (const span of args.doc.provenance[part.id]?.text ?? []) {
+      spans.push({ ...span, start: span.start + offset, end: span.end + offset });
