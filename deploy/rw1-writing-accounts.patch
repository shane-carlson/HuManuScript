+import { useEffect, useState, type FormEvent } from 'react'
+import { Link, useLocation, useSearchParams } from 'react-router-dom'
+import { Seo } from '../components/Seo'
+import './WritingAccount.css'
+
+const TOKEN_KEY = 'humanuscript.account.token'
+const RETURN_URL = 'humanuscript://open'
+const DOWNLOADS = [
+  ['Apple silicon', 'https://github.com/shane-carlson/HuManuScript/releases/download/v0.1.52/HuManuScript-0.1.52-arm64.dmg'],
+  ['Intel Mac', 'https://github.com/shane-carlson/HuManuScript/releases/download/v0.1.52/HuManuScript-0.1.52-x64.dmg'],
+  ['Windows', 'https://github.com/shane-carlson/HuManuScript/releases/download/v0.1.52/HuManuScript-0.1.52-x64.exe'],
+] as const
+
+type AccountUser = { id: string; email: string; displayName: string }
+type ToolLine = { id: string; name: string; sync: boolean; connected: boolean }
+type Screen = 'home' | 'sign-in' | 'sign-up' | 'manage'
+
+export function WritingAccount() {
+  const { pathname } = useLocation()
+  const [params] = useSearchParams()
+  const fromApp = params.get('from') === 'app'
+  const screen = screenFor(pathname)
+  const query = fromApp ? '?from=app' : ''
+
+  return (
+    <div className="writing-account">
+      <Seo
+        title="HuManuScript account"
+        description="Create a HuManuScript account or sign in. The account is for manuscript sync, and later writing tools can share it."
+        path="/humanuscript/account"
+        noIndex
+      />
+      {fromApp ? (
+        <a className="writing-account-back" href={RETURN_URL}>
+          Back to HuManuScript
+        </a>
+      ) : null}
+      {screen === 'home' ? <Landing query={query} /> : null}
+      {screen === 'sign-in' || screen === 'sign-up' ? (
+        <AuthForm kind={screen} fromApp={fromApp} query={query} />
+      ) : null}
+      {screen === 'manage' ? <Manage fromApp={fromApp} query={query} /> : null}
+    </div>
+  )
+}
+
+function Landing({ query }: { query: string }) {
+  return (
+    <>
+      <header className="writing-account-brand">
+        <img src="/icons/humanuscript-logo.png" alt="" width={72} height={72} />
+        <p className="writing-account-mark">HuManuScript</p>
+        <p className="writing-account-tag">Proof of humanity in Prose.</p>
+      </header>
+      <main>
+        <h1>A manuscript editor with a seal on every passage you type.</h1>
+        <p>
+          HuManuScript keeps your books on this computer. An account is only for sync, and it belongs to
+          HuManuScript. SpeakFiction can use the same sign-in later.
+        </p>
+        <div className="writing-account-actions">
+          <Link className="writing-account-button primary" to={`/humanuscript/account/sign-up${query}`}>
+            Create account
+          </Link>
+          <Link className="writing-account-button" to={`/humanuscript/account/sign-in${query}`}>
+            Sign in
+          </Link>
+        </div>
+        <h2>Download HuManuScript 0.1.52</h2>
+        <div className="writing-account-actions">
+          {DOWNLOADS.map(([label, href]) => (
+            <a className="writing-account-button" key={label} href={href}>
+              {label}
+            </a>
+          ))}
+        </div>
+      </main>
+    </>
+  )
+}
+
+function AuthForm({ kind, fromApp, query }: { kind: 'sign-in' | 'sign-up'; fromApp: boolean; query: string }) {
+  const [error, setError] = useState('')
+  const [pending, setPending] = useState(false)
+  const creating = kind === 'sign-up'
+
+  async function onSubmit(event: FormEvent<HTMLFormElement>) {
+    event.preventDefault()
+    const data = new FormData(event.currentTarget)
+    const email = String(data.get('email') ?? '')
+    const password = String(data.get('password') ?? '')
+    const displayName = String(data.get('displayName') ?? '')
+    setPending(true)
+    setError('')
+    const result = await send(creating ? '/api/writing-accounts/signup' : '/api/writing-accounts/login', {
+      email,
+      password,
+      displayName,
+      tool: 'humanuscript',
+    })
+    setPending(false)
+    if (!result.ok || typeof result.payload.token !== 'string') {
+      setError(messageOf(result.payload, 'The account service did not accept that.'))
+      return
+    }
+    localStorage.setItem(TOKEN_KEY, result.payload.token)
+    window.location.assign(`/humanuscript/account/manage${query}`)
+  }
+
+  return (
+    <main className="writing-account-card">
+      <p className="writing-account-mark">HuManuScript</p>
+      <h1>{creating ? 'Create a HuManuScript account' : 'Sign in to HuManuScript'}</h1>
+      <p>This account is for HuManuScript. Other writing tools can share it later.</p>
+      <form onSubmit={onSubmit}>
+        {creating ? (
+          <label>
+            Display name
+            <input name="displayName" maxLength={40} required />
+          </label>
+        ) : null}
+        <label>
+          Email
+          <input name="email" type="email" autoComplete="username" required />
+        </label>
+        <label>
+          Password
+          <input
+            name="password"
+            type="password"
+            autoComplete={creating ? 'new-password' : 'current-password'}
+            required
+          />
+        </label>
+        <p className="writing-account-hint">At least 12 characters, with uppercase, lowercase, a number, and a symbol.</p>
+        {error ? <p className="writing-account-error" role="alert">{error}</p> : null}
+        <div className="writing-account-actions">
+          <button className="writing-account-button primary" type="submit" disabled={pending}>
+            {creating ? 'Create account' : 'Sign in'}
+          </button>
+          {fromApp ? (
+            <a className="writing-account-button" href={RETURN_URL}>Back to HuManuScript</a>
+          ) : (
+            <Link className="writing-account-button" to={`/humanuscript/account${query}`}>HuManuScript home</Link>
+          )}
+        </div>
+      </form>
+    </main>
+  )
+}
+
+function Manage({ fromApp, query }: { fromApp: boolean; query: string }) {
+  const [user, setUser] = useState<AccountUser | null>(null)
+  const [tools, setTools] = useState<ToolLine[]>([])
+  const [error, setError] = useState('')
+  const [notice, setNotice] = useState('')
+
+  useEffect(() => {
+    const token = localStorage.getItem(TOKEN_KEY)
+    if (!token) {
+      window.location.replace(`/humanuscript/account/sign-in${query}`)
+      return
+    }
+    let cancelled = false
+    void Promise.all([
+      send('/api/writing-accounts/me', undefined, token, 'GET'),
+      send('/api/writing-accounts/tools', undefined, token, 'GET'),
+    ]).then(([me, listed]) => {
+      if (cancelled) return
+      const nextUser = me.payload.user
+      if (!me.ok || !isUser(nextUser)) {
+        localStorage.removeItem(TOKEN_KEY)
+        window.location.replace(`/humanuscript/account/sign-in${query}`)
+        return
+      }
+      setUser(nextUser)
+      setTools(Array.isArray(listed.payload.tools) ? listed.payload.tools.filter(isTool) : [])
+    })
+    return () => {
+      cancelled = true
+    }
+  }, [query])
+
+  async function saveName(event: FormEvent<HTMLFormElement>) {
+    event.preventDefault()
+    const token = localStorage.getItem(TOKEN_KEY) ?? ''
+    const displayName = String(new FormData(event.currentTarget).get('displayName') ?? '')
+    const result = await send('/api/writing-accounts/profile', { displayName }, token, 'PATCH')
+    if (!result.ok || !isUser(result.payload.user)) {
+      setError(messageOf(result.payload, 'The name was not saved.'))
+      return
+    }
+    setUser(result.payload.user)
+    setError('')
+    setNotice('Name saved.')
+  }
+
+  async function savePassword(event: FormEvent<HTMLFormElement>) {
+    event.preventDefault()
+    const token = localStorage.getItem(TOKEN_KEY) ?? ''
+    const data = new FormData(event.currentTarget)
+    const result = await send('/api/writing-accounts/password', {
+      currentPassword: String(data.get('currentPassword') ?? ''),
+      password: String(data.get('password') ?? ''),
+    }, token)
+    if (!result.ok) {
+      setError(messageOf(result.payload, 'The password was not changed.'))
+      return
+    }
+    event.currentTarget.reset()
+    setError('')
+    setNotice('Password changed.')
+  }
+
+  function signOut() {
+    const token = localStorage.getItem(TOKEN_KEY) ?? ''
+    void send('/api/writing-accounts/logout', {}, token)
+    localStorage.removeItem(TOKEN_KEY)
+    window.location.assign(`/humanuscript/account${query}`)
+  }
+
+  return (
+    <main className="writing-account-card">
+      <p className="writing-account-mark">HuManuScript</p>
+      <h1>{user ? user.displayName : 'Account'}</h1>
+      <p>{user ? user.email : 'Loading the account.'}</p>
+      <p>This is your HuManuScript account. SpeakFiction and other writing tools can use the same sign-in later.</p>
+      {error ? <p className="writing-account-error" role="alert">{error}</p> : null}
+      {notice ? <p className="writing-account-notice">{notice}</p> : null}
+      <form onSubmit={saveName}>
+        <label>
+          Display name
+          <input name="displayName" maxLength={40} defaultValue={user?.displayName ?? ''} key={user?.displayName} required />
+        </label>
+        <button className="writing-account-button primary" type="submit">Save name</button>
+      </form>
+      <form onSubmit={savePassword}>
+        <label>
+          Current password
+          <input name="currentPassword" type="password" autoComplete="current-password" required />
+        </label>
+        <label>
+          New password
+          <input name="password" type="password" autoComplete="new-password" required />
+        </label>
+        <button className="writing-account-button primary" type="submit">Change password</button>
+      </form>
+      <h2>Writing tools</h2>
+      <ul className="writing-account-tools">
+        {tools.map((tool) => (
+          <li key={tool.id}>
+            <strong>{tool.name}</strong>
+            <span>
+              {tool.connected
+                ? tool.sync
+                  ? 'Connected. This app syncs its books here.'
+                  : 'Connected. Sync for this tool comes later.'
+                : 'Available later. It can use this same sign-in.'}
+            </span>
+          </li>
+        ))}
+      </ul>
+      <div className="writing-account-actions">
+        <button className="writing-account-button" type="button" onClick={signOut}>Sign out</button>
+        {fromApp ? (
+          <a className="writing-account-button" href={RETURN_URL}>Back to HuManuScript</a>
+        ) : (
+          <Link className="writing-account-button" to="/humanuscript/account">HuManuScript home</Link>
+        )}
+      </div>
+    </main>
+  )
+}
+
+function screenFor(pathname: string): Screen {
+  if (pathname === '/humanuscript/account/sign-in') return 'sign-in'
+  if (pathname === '/humanuscript/account/sign-up') return 'sign-up'
+  if (pathname === '/humanuscript/account/manage') return 'manage'
+  return 'home'
+}
+
+async function send(
+  path: string,
+  body?: unknown,
+  token?: string,
+  method = 'POST',
+): Promise<{ ok: boolean; payload: Record<string, unknown> }> {
+  const headers: Record<string, string> = {}
+  if (body !== undefined) headers['Content-Type'] = 'application/json'
+  if (token) headers.Authorization = `Bearer ${token}`
+  const response = await fetch(path, {
+    method,
+    headers,
+    body: body === undefined ? undefined : JSON.stringify(body),
+  })
+  const payload = await response.json().catch(() => ({}))
+  return {
+    ok: response.ok,
+    payload: payload && typeof payload === 'object' ? payload as Record<string, unknown> : {},
+  }
+}
+
+function messageOf(payload: Record<string, unknown>, fallback: string): string {
+  return typeof payload.message === 'string' ? payload.message : fallback
+}
+
+function isUser(value: unknown): value is AccountUser {
+  if (!value || typeof value !== 'object') return false
+  const user = value as AccountUser
+  return typeof user.id === 'string' && typeof user.email === 'string' && typeof user.displayName === 'string'
+}
+
+function isTool(value: unknown): value is ToolLine {
+  if (!value || typeof value !== 'object') return false
+  const tool = value as ToolLine
+  return typeof tool.id === 'string' && typeof tool.name === 'string'
+}
