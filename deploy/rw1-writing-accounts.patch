+import assert from 'node:assert/strict'
+import { mkdtemp, rm } from 'node:fs/promises'
+import { register } from 'node:module'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { pathToFileURL } from 'node:url'
+
+register(new URL('./writing-account-resolve.mjs', import.meta.url), pathToFileURL(process.cwd() + '/'))
+
+const { fileWritingStore } = await import('../api/_lib/writingAccounts.ts')
+const { handleWritingAccount } = await import('../api/_lib/writingAccountsHttp.ts')
+
+const root = await mkdtemp(join(tmpdir(), 'writing-accounts-'))
+const store = fileWritingStore(root)
+const password = 'Harbor-Key-1!'
+
+try {
+  const oldAccount = await handleWritingAccount(
+    request('/api/account/signup', 'POST', { email: 'ada@example.com', password, displayName: 'Ada', tool: 'humanuscript' }),
+    'missing',
+    store,
+  )
+  assert.equal(oldAccount.status, 404)
+
+  const created = await json(await handleWritingAccount(
+    request('/api/writing-accounts/signup', 'POST', { email: 'ada@example.com', password, displayName: 'Ada', tool: 'humanuscript' }),
+    'signup',
+    store,
+  ))
+  assert.equal(created.status, 201)
+  assert.equal(created.body.tokenType, 'Bearer')
+  assert.equal(created.body.user.email, 'ada@example.com')
+  const token = created.body.token
+
+  const duplicate = await handleWritingAccount(
+    request('/api/writing-accounts/signup', 'POST', { email: 'ada@example.com', password, displayName: 'Ada', tool: 'humanuscript' }),
+    'signup',
+    store,
+  )
+  assert.equal(duplicate.status, 409)
+
+  const tools = await json(await handleWritingAccount(
+    request('/api/writing-accounts/tools', 'GET', null, token),
+    'tools',
+    store,
+  ))
+  assert.equal(tools.body.tools.find((tool) => tool.id === 'humanuscript').connected, true)
+  assert.equal(tools.body.tools.find((tool) => tool.id === 'speakfiction').sync, false)
+
+  const speak = await handleWritingAccount(
+    request('/api/writing-accounts/sync/speakfiction', 'PUT', { snapshot: { books: [] } }, token),
+    'sync/speakfiction',
+    store,
+  )
+  assert.equal(speak.status, 404)
+
+  const empty = await json(await handleWritingAccount(
+    request('/api/writing-accounts/sync/humanuscript', 'GET', null, token),
+    'sync/humanuscript',
+    store,
+  ))
+  assert.equal(empty.body.snapshot, null)
+
+  const saved = await json(await handleWritingAccount(
+    request('/api/writing-accounts/sync/humanuscript', 'PUT', { snapshot: { books: [{ title: 'Harbor' }] } }, token),
+    'sync/humanuscript',
+    store,
+  ))
+  assert.equal(saved.status, 200)
+  const revision = saved.body.revision
+  assert.ok(revision)
+
+  const conflict = await handleWritingAccount(
+    request('/api/writing-accounts/sync/humanuscript', 'PUT', { snapshot: { books: [] } }, token, '"stale"'),
+    'sync/humanuscript',
+    store,
+  )
+  assert.equal(conflict.status, 409)
+
+  const renamed = await json(await handleWritingAccount(
+    request('/api/writing-accounts/profile', 'PATCH', { displayName: 'Ada Lovelace' }, token),
+    'profile',
+    store,
+  ))
+  assert.equal(renamed.body.user.displayName, 'Ada Lovelace')
+
+  console.log('writing accounts ok')
+} finally {
+  await rm(root, { recursive: true, force: true })
+}
+
+function request(path, method, body, token, ifMatch) {
+  const headers = new Headers()
+  if (token) headers.set('authorization', `Bearer ${token}`)
+  if (ifMatch) headers.set('if-match', ifMatch)
+  return new Request(`https://www.readywriter.one${path}`, {
+    method,
+    headers,
+    body: body == null ? undefined : JSON.stringify(body),
+  })
+}
+
+async function json(response) {
+  return { status: response.status, body: await response.json() }
+}
