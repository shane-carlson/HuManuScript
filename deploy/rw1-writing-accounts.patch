new file mode 100644
index 0000000..5e05865
--- /dev/null
+++ b/api/_lib/writingAccounts.ts
@@ -0,0 +1,338 @@
+import { createHash, randomBytes, scryptSync, timingSafeEqual } from 'node:crypto'
+import { mkdirSync, readFileSync, unlinkSync, writeFileSync } from 'node:fs'
+import { dirname, join } from 'node:path'
+
+/**
+ * HuManuScript writing accounts. This store is not the Ready Writer One
+ * account vault and it is not /api/humanuscript/sync.
+ *
+ * Pages: /humanuscript/account and the sign-in, sign-up, and manage paths under it.
+ * API:   /api/writing-accounts/*
+ */
+
+export const WRITING_ACCOUNT_PAGES = {
+  home: '/humanuscript/account',
+  signIn: '/humanuscript/account/sign-in',
+  signUp: '/humanuscript/account/sign-up',
+  manage: '/humanuscript/account/manage',
+} as const
+
+export const WRITING_TOOLS = [
+  { id: 'humanuscript', name: 'HuManuScript', sync: true },
+  { id: 'speakfiction', name: 'SpeakFiction', sync: false },
+] as const
+
+export const SNAPSHOT_BYTE_LIMIT = 4_400_000
+
+const ACCOUNT_ID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i
+
+export class WritingStorageUnavailable extends Error {
+  constructor() {
+    super('Writing account storage is not configured.')
+    this.name = 'WritingStorageUnavailable'
+  }
+}
+
+export type PublicUser = {
+  id: string
+  email: string
+  displayName: string
+  tools: string[]
+}
+
+export type ToolLine = {
+  id: string
+  name: string
+  sync: boolean
+  connected: boolean
+}
+
+type StoredUser = PublicUser & {
+  passwordHash: string
+  passwordSalt: string
+}
+
+type StoredSession = {
+  userId: string
+  emailHash: string
+}
+
+type StoredSnapshot = {
+  revision: string
+  updatedAt: string
+  body: Record<string, unknown>
+}
+
+export type WritingStore = {
+  createUser(input: { email: string; password: string; displayName: string; tool: string | null }): Promise<
+    { ok: true; user: PublicUser; token: string } | { ok: false; status: number; message: string }
+  >
+  login(input: { email: string; password: string; tool: string | null }): Promise<
+    { ok: true; user: PublicUser; token: string } | { ok: false; status: number; message: string }
+  >
+  userForToken(token: string): Promise<PublicUser | null>
+  logout(token: string): Promise<void>
+  updateProfile(token: string, displayName: string): Promise<
+    { ok: true; user: PublicUser } | { ok: false; status: number; message: string }
+  >
+  changePassword(token: string, currentPassword: string, nextPassword: string): Promise<
+    { ok: true } | { ok: false; status: number; message: string }
+  >
+  connectTool(token: string, toolId: string): Promise<
+    { ok: true; tools: ToolLine[] } | { ok: false; status: number; message: string }
+  >
+  toolsFor(token: string): Promise<{ ok: true; tools: ToolLine[] } | { ok: false; status: number; message: string }>
+  readSnapshot(token: string, toolId: string): Promise<
+    { ok: true; snapshot: StoredSnapshot | null } | { ok: false; status: number; message: string }
+  >
+  writeSnapshot(
+    token: string,
+    toolId: string,
+    body: Record<string, unknown>,
+    ifMatch: string | null,
+  ): Promise<
+    | { ok: true; snapshot: StoredSnapshot }
+    | { ok: false; status: number; message?: string; snapshot?: StoredSnapshot | null }
+  >
+}
+
+type RecordIO = {
+  read(path: string): Promise<string | null>
+  writeNew(path: string, text: string): Promise<boolean>
+  write(path: string, text: string): Promise<void>
+  remove(path: string): Promise<void>
+}
+
+export function fileWritingStore(root: string): WritingStore {
+  return storeFromIo({
+    async read(path) {
+      try {
+        return readFileSync(join(root, path), 'utf8')
+      } catch (error) {
+        if ((error as NodeJS.ErrnoException).code === 'ENOENT') return null
+        throw error
+      }
+    },
+    async writeNew(path, text) {
+      const full = join(root, path)
+      mkdirSync(dirname(full), { recursive: true })
+      try {
+        writeFileSync(full, text, { flag: 'wx' })
+        return true
+      } catch (error) {
+        if ((error as NodeJS.ErrnoException).code === 'EEXIST') return false
+        throw error
+      }
+    },
+    async write(path, text) {
+      const full = join(root, path)
+      mkdirSync(dirname(full), { recursive: true })
+      writeFileSync(full, text)
+    },
+    async remove(path) {
+      try {
+        unlinkSync(join(root, path))
+      } catch (error) {
+        if ((error as NodeJS.ErrnoException).code === 'ENOENT') return
+        throw error
+      }
+    },
+  })
+}
+
+export function storeFromIo(io: RecordIO): WritingStore {
+  return {
+    async createUser(input) {
+      const email = input.email.trim().toLowerCase()
+      const emailHash = hashEmail(email)
+      const existing = await readJson<StoredUser>(io, userPath(emailHash))
+      if (existing) return { ok: false, status: 409, message: 'An account with that email already exists.' }
+      const salt = randomBytes(16).toString('base64url')
+      const user: StoredUser = {
+        id: newAccountId(),
+        email,
+        displayName: input.displayName.trim(),
+        passwordHash: hashPassword(input.password, salt),
+        passwordSalt: salt,
+        tools: input.tool ? [input.tool] : [],
+      }
+      const created = await io.writeNew(userPath(emailHash), JSON.stringify(user))
+      if (!created) return { ok: false, status: 409, message: 'An account with that email already exists.' }
+      const token = await openSession(io, user.id, emailHash)
+      return { ok: true, user: publicUser(user), token }
+    },
+    async login(input) {
+      const email = input.email.trim().toLowerCase()
+      const emailHash = hashEmail(email)
+      const user = await readJson<StoredUser>(io, userPath(emailHash))
+      if (!user || !passwordMatches(input.password, user)) {
+        return { ok: false, status: 401, message: 'Email or password is incorrect.' }
+      }
+      if (input.tool && !user.tools.includes(input.tool)) {
+        user.tools.push(input.tool)
+        await io.write(userPath(emailHash), JSON.stringify(user))
+      }
+      const token = await openSession(io, user.id, emailHash)
+      return { ok: true, user: publicUser(user), token }
+    },
+    async userForToken(token) {
+      const session = await readJson<StoredSession>(io, sessionPath(hashToken(token)))
+      if (!session) return null
+      const user = await readJson<StoredUser>(io, userPath(session.emailHash))
+      return user && user.id === session.userId ? publicUser(user) : null
+    },
+    async logout(token) {
+      await io.remove(sessionPath(hashToken(token)))
+    },
+    async updateProfile(token, displayName) {
+      const found = await privateUser(io, token)
+      if (!found) return { ok: false, status: 401, message: 'Sign in again.' }
+      found.user.displayName = displayName.trim()
+      await io.write(userPath(found.session.emailHash), JSON.stringify(found.user))
+      return { ok: true, user: publicUser(found.user) }
+    },
+    async changePassword(token, currentPassword, nextPassword) {
+      const found = await privateUser(io, token)
+      if (!found) return { ok: false, status: 401, message: 'Sign in again.' }
+      if (!passwordMatches(currentPassword, found.user)) {
+        return { ok: false, status: 401, message: 'The current password is incorrect.' }
+      }
+      found.user.passwordSalt = randomBytes(16).toString('base64url')
+      found.user.passwordHash = hashPassword(nextPassword, found.user.passwordSalt)
+      await io.write(userPath(found.session.emailHash), JSON.stringify(found.user))
+      return { ok: true }
+    },
+    async connectTool(token, toolId) {
+      const found = await privateUser(io, token)
+      if (!found) return { ok: false, status: 401, message: 'Sign in again.' }
+      const tool = WRITING_TOOLS.find((item) => item.id === toolId)
+      if (!tool) return { ok: false, status: 400, message: 'That writing tool is not part of this account yet.' }
+      if (!found.user.tools.includes(tool.id)) found.user.tools.push(tool.id)
+      await io.write(userPath(found.session.emailHash), JSON.stringify(found.user))
+      return { ok: true, tools: toolCatalog(found.user) }
+    },
+    toolsFor: async (token) => {
+      const found = await privateUser(io, token)
+      if (!found) return { ok: false, status: 401, message: 'Sign in again.' }
+      return { ok: true, tools: toolCatalog(found.user) }
+    },
+    async readSnapshot(token, toolId) {
+      const found = await privateUser(io, token)
+      if (!found) return { ok: false, status: 401, message: 'Sign in again to sync. Your books are still on this computer.' }
+      const tool = WRITING_TOOLS.find((item) => item.id === toolId)
+      if (!tool?.sync) return { ok: false, status: 404, message: 'That writing tool does not sync from HuManuScript.' }
+      return { ok: true, snapshot: await readJson<StoredSnapshot>(io, snapshotPath(toolId, found.user.id)) }
+    },
+    async writeSnapshot(token, toolId, body, ifMatch) {
+      const found = await privateUser(io, token)
+      if (!found) return { ok: false, status: 401, message: 'Sign in again to sync. Your books are still on this computer.' }
+      const tool = WRITING_TOOLS.find((item) => item.id === toolId)
+      if (!tool?.sync) return { ok: false, status: 404, message: 'That writing tool does not sync from HuManuScript.' }
+      if (Buffer.byteLength(JSON.stringify(body)) > SNAPSHOT_BYTE_LIMIT) {
+        return { ok: false, status: 413, message: 'This library is too large to sync.' }
+      }
+      const current = await readJson<StoredSnapshot>(io, snapshotPath(toolId, found.user.id))
+      const expected = unquote(ifMatch)
+      if (current && expected !== current.revision) return { ok: false, status: 409, snapshot: current }
+      if (!current && expected) return { ok: false, status: 409, snapshot: null }
+      const saved: StoredSnapshot = {
+        revision: randomBytes(8).toString('hex'),
+        updatedAt: new Date().toISOString(),
+        body,
+      }
+      await io.write(snapshotPath(toolId, found.user.id), JSON.stringify(saved))
+      return { ok: true, snapshot: saved }
+    },
+  }
+}
+
+export function defaultWritingRoot(): string {
+  return process.env.WRITING_ACCOUNTS_DIR?.trim() || join(process.cwd(), 'data/writing-accounts')
+}
+
+function userPath(emailHash: string): string {
+  return `writing-accounts/users/${emailHash}.json`
+}
+
+function sessionPath(tokenHash: string): string {
+  return `writing-accounts/sessions/${tokenHash}.json`
+}
+
+function snapshotPath(toolId: string, accountId: string): string {
+  if (!ACCOUNT_ID.test(accountId)) throw new Error('Invalid account id.')
+  if (!/^[a-z0-9-]+$/.test(toolId)) throw new Error('Invalid writing tool.')
+  return `writing-accounts/sync/${toolId}/${accountId.toLowerCase()}.json`
+}
+
+async function openSession(io: RecordIO, userId: string, emailHash: string): Promise<string> {
+  const token = randomBytes(32).toString('base64url')
+  const record: StoredSession = { userId, emailHash }
+  await io.write(sessionPath(hashToken(token)), JSON.stringify(record))
+  return token
+}
+
+async function privateUser(io: RecordIO, token: string): Promise<{ user: StoredUser; session: StoredSession } | null> {
+  const session = await readJson<StoredSession>(io, sessionPath(hashToken(token)))
+  if (!session) return null
+  const user = await readJson<StoredUser>(io, userPath(session.emailHash))
+  if (!user || user.id !== session.userId) return null
+  return { user, session }
+}
+
+async function readJson<T>(io: RecordIO, path: string): Promise<T | null> {
+  const text = await io.read(path)
+  if (!text) return null
+  try {
+    return JSON.parse(text) as T
+  } catch {
+    return null
+  }
+}
+
+function publicUser(user: StoredUser): PublicUser {
+  return { id: user.id, email: user.email, displayName: user.displayName, tools: [...user.tools] }
+}
+
+function toolCatalog(user: StoredUser): ToolLine[] {
+  return WRITING_TOOLS.map((tool) => ({
+    id: tool.id,
+    name: tool.name,
+    sync: tool.sync,
+    connected: user.tools.includes(tool.id),
+  }))
+}
+
+function hashEmail(email: string): string {
+  return createHash('sha256').update(email).digest('hex')
+}
+
+function hashToken(token: string): string {
+  return createHash('sha256').update(token).digest('base64url')
+}
+
+function hashPassword(password: string, salt: string): string {
+  return scryptSync(password, salt, 32).toString('base64url')
+}
+
+function passwordMatches(password: string, user: StoredUser): boolean {
+  const next = Buffer.from(hashPassword(password, user.passwordSalt))
+  const saved = Buffer.from(user.passwordHash)
+  return next.length === saved.length && timingSafeEqual(next, saved)
+}
+
+function newAccountId(): string {
+  const bytes = randomBytes(16)
+  bytes[6] = (bytes[6]! & 0x0f) | 0x40
+  bytes[8] = (bytes[8]! & 0x3f) | 0x80
+  const hex = bytes.toString('hex')
+  return `${hex.slice(0, 8)}-${hex.slice(8, 12)}-${hex.slice(12, 16)}-${hex.slice(16, 20)}-${hex.slice(20)}`
+}
+
+function unquote(value: string | null): string | null {
+  if (!value) return null
+  let text = value.trim()
+  if (!text) return null
+  if (text.startsWith('W/')) text = text.slice(2).trim()
+  if (text.startsWith('"') && text.endsWith('"')) text = text.slice(1, -1)
+  return text || null
+}
diff --git a/api/_lib/writingAccountsBlob.ts b/api/_lib/writingAccountsBlob.ts
new file mode 100644
index 0000000..6de261f
--- /dev/null
+++ b/api/_lib/writingAccountsBlob.ts
@@ -0,0 +1,53 @@
+import { BlobNotFoundError, del, get, put } from '@vercel/blob'
+import { storeFromIo, type WritingStore } from './writingAccounts.js'
+
+export function blobWritingStore(): WritingStore {
+  return storeFromIo({
+    async read(path) {
+      try {
+        const blob = await get(path, { access: 'private' })
+        if (!blob || blob.statusCode !== 200 || !blob.stream) return null
+        return await new Response(blob.stream).text()
+      } catch (error) {
+        if (error instanceof BlobNotFoundError) return null
+        throw error
+      }
+    },
+    async writeNew(path, text) {
+      try {
+        await put(path, text, {
+          access: 'private',
+          addRandomSuffix: false,
+          allowOverwrite: false,
+          contentType: 'application/json',
+        })
+        return true
+      } catch (error) {
+        if (alreadyExists(error)) return false
+        throw error
+      }
+    },
+    async write(path, text) {
+      await put(path, text, {
+        access: 'private',
+        addRandomSuffix: false,
+        allowOverwrite: true,
+        contentType: 'application/json',
+      })
+    },
+    async remove(path) {
+      try {
+        await del(path)
+      } catch (error) {
+        if (error instanceof BlobNotFoundError) return
+        throw error
+      }
+    },
+  })
+}
+
+function alreadyExists(error: unknown): boolean {
+  const name = error instanceof Error ? error.name : ''
+  const message = error instanceof Error ? error.message : ''
+  return /already exists/i.test(message) || /AlreadyExists/.test(name)
+}
diff --git a/api/_lib/writingAccountsHttp.ts b/api/_lib/writingAccountsHttp.ts
new file mode 100644
index 0000000..7d81cbe
--- /dev/null
+++ b/api/_lib/writingAccountsHttp.ts
@@ -0,0 +1,264 @@
+import { SNAPSHOT_BYTE_LIMIT, defaultWritingRoot, fileWritingStore, type WritingStore } from './writingAccounts.js'
+
+const EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]+$/
+
+type AccountRequest = {
+  method: string
+  url: string
+  headers: { get(name: string): string | null }
+  json(): Promise<unknown>
+}
+
+export async function handleWritingAccount(
+  request: AccountRequest,
+  action: string,
+  store: WritingStore = defaultStore(),
+): Promise<Response> {
+  if (request.method === 'OPTIONS') return cors(new Response(null, { status: 204 }))
+  try {
+    const response = await route(request, action, store)
+    return cors(response)
+  } catch (error) {
+    const message = error instanceof Error ? error.message : 'Writing accounts are unavailable.'
+    return cors(json({ message }, 500))
+  }
+}
+
+function defaultStore(): WritingStore {
+  if (process.env.BLOB_READ_WRITE_TOKEN?.trim() || process.env.BLOB_STORE_ID?.trim()) {
+    throw new Error('Use the blob store when a Vercel Blob token is set.')
+  }
+  if (process.env.VERCEL) {
+    throw new Error('Writing accounts need a Vercel Blob store.')
+  }
+  return fileWritingStore(defaultWritingRoot())
+}
+
+export async function writingStoreForRequest(): Promise<WritingStore> {
+  const hasBlob = Boolean(process.env.BLOB_READ_WRITE_TOKEN?.trim() || process.env.BLOB_STORE_ID?.trim())
+  if (hasBlob) {
+    const { blobWritingStore } = await import('./writingAccountsBlob.js')
+    return blobWritingStore()
+  }
+  if (process.env.VERCEL) {
+    return {
+      async createUser() {
+        return { ok: false, status: 503, message: 'Writing accounts need a Vercel Blob store.' }
+      },
+      async login() {
+        return { ok: false, status: 503, message: 'Writing accounts need a Vercel Blob store.' }
+      },
+      async userForToken() {
+        return null
+      },
+      async logout() {},
+      async updateProfile() {
+        return { ok: false, status: 503, message: 'Writing accounts need a Vercel Blob store.' }
+      },
+      async changePassword() {
+        return { ok: false, status: 503, message: 'Writing accounts need a Vercel Blob store.' }
+      },
+      async connectTool() {
+        return { ok: false, status: 503, message: 'Writing accounts need a Vercel Blob store.' }
+      },
+      async toolsFor() {
+        return { ok: false, status: 503, message: 'Writing accounts need a Vercel Blob store.' }
+      },
+      async readSnapshot() {
+        return { ok: false, status: 503, message: 'Writing accounts need a Vercel Blob store.' }
+      },
+      async writeSnapshot() {
+        return { ok: false, status: 503, message: 'Writing accounts need a Vercel Blob store.' }
+      },
+    }
+  }
+  return fileWritingStore(defaultWritingRoot())
+}
+
+async function route(request: AccountRequest, action: string, store: WritingStore): Promise<Response> {
+  const syncTool = /^sync\/([a-z0-9-]+)$/.exec(action)?.[1] ?? null
+  if (request.method === 'POST' && action === 'signup') return signup(request, store)
+  if (request.method === 'POST' && action === 'login') return login(request, store)
+  if (request.method === 'POST' && action === 'logout') return logout(request, store)
+  if (request.method === 'GET' && action === 'me') return me(request, store)
+  if (request.method === 'PATCH' && action === 'profile') return profile(request, store)
+  if (request.method === 'POST' && action === 'password') return password(request, store)
+  if (request.method === 'GET' && action === 'tools') return tools(request, store)
+  if (syncTool && request.method === 'GET') return readSync(request, store, syncTool)
+  if (syncTool && request.method === 'PUT') return writeSync(request, store, syncTool)
+  return json({ message: 'Not found.' }, 404)
+}
+
+async function signup(request: AccountRequest, store: WritingStore): Promise<Response> {
+  const fields = await accountFields(request, true)
+  if (!fields.ok) return json({ message: fields.message }, fields.status)
+  const created = await store.createUser(fields)
+  if (!created.ok) return json({ message: created.message }, created.status)
+  return json({ token: created.token, tokenType: 'Bearer', user: created.user }, 201)
+}
+
+async function login(request: AccountRequest, store: WritingStore): Promise<Response> {
+  const fields = await accountFields(request, false)
+  if (!fields.ok) return json({ message: fields.message }, fields.status)
+  const signedIn = await store.login({ email: fields.email, password: fields.password, tool: fields.tool })
+  if (!signedIn.ok) return json({ message: signedIn.message }, signedIn.status)
+  return json({ token: signedIn.token, tokenType: 'Bearer', user: signedIn.user })
+}
+
+async function logout(request: AccountRequest, store: WritingStore): Promise<Response> {
+  const token = bearer(request)
+  if (token) await store.logout(token)
+  return json({ ok: true })
+}
+
+async function me(request: AccountRequest, store: WritingStore): Promise<Response> {
+  const user = await store.userForToken(bearer(request) ?? '')
+  if (!user) return json({ message: 'Sign in again.' }, 401)
+  return json({ user })
+}
+
+async function profile(request: AccountRequest, store: WritingStore): Promise<Response> {
+  const token = bearer(request)
+  if (!token) return json({ message: 'Sign in again.' }, 401)
+  const body = await readJson(request)
+  const displayName = text(body, 'displayName')
+  const invalid = validateName(displayName)
+  if (invalid) return json({ message: invalid }, 400)
+  const updated = await store.updateProfile(token, displayName)
+  if (!updated.ok) return json({ message: updated.message }, updated.status)
+  return json({ user: updated.user })
+}
+
+async function password(request: AccountRequest, store: WritingStore): Promise<Response> {
+  const token = bearer(request)
+  if (!token) return json({ message: 'Sign in again.' }, 401)
+  const body = await readJson(request)
+  const currentPassword = text(body, 'currentPassword')
+  const nextPassword = text(body, 'password')
+  const invalid = validatePassword(nextPassword)
+  if (invalid) return json({ message: invalid }, 400)
+  const changed = await store.changePassword(token, currentPassword, nextPassword)
+  if (!changed.ok) return json({ message: changed.message }, changed.status)
+  return json({ ok: true })
+}
+
+async function tools(request: AccountRequest, store: WritingStore): Promise<Response> {
+  const listed = await store.toolsFor(bearer(request) ?? '')
+  if (!listed.ok) return json({ message: listed.message }, listed.status)
+  return json({ tools: listed.tools })
+}
+
+async function readSync(request: AccountRequest, store: WritingStore, toolId: string): Promise<Response> {
+  const read = await store.readSnapshot(bearer(request) ?? '', toolId)
+  if (!read.ok) return json({ message: read.message }, read.status)
+  if (!read.snapshot) return json({ snapshot: null })
+  return snapshotResponse(read.snapshot, 200)
+}
+
+async function writeSync(request: AccountRequest, store: WritingStore, toolId: string): Promise<Response> {
+  const body = await readJson(request)
+  const snapshot = body.snapshot
+  if (!snapshot || typeof snapshot !== 'object' || Array.isArray(snapshot)) {
+    return json({ message: 'The sync body needs a snapshot object.' }, 400)
+  }
+  const written = await store.writeSnapshot(
+    bearer(request) ?? '',
+    toolId,
+    snapshot as Record<string, unknown>,
+    request.headers.get('if-match'),
+  )
+  if (!written.ok && written.status === 409) {
+    if (!written.snapshot) return json({ snapshot: null }, 409)
+    return snapshotResponse(written.snapshot, 409)
+  }
+  if (!written.ok) return json({ message: written.message ?? 'Sync failed.' }, written.status)
+  return snapshotResponse(written.snapshot, 200)
+}
+
+async function accountFields(
+  request: AccountRequest,
+  creating: boolean,
+): Promise<
+  | { ok: true; email: string; password: string; displayName: string; tool: string | null }
+  | { ok: false; status: number; message: string }
+> {
+  const body = await readJson(request)
+  const email = text(body, 'email').toLowerCase()
+  const password = text(body, 'password')
+  const displayName = text(body, 'displayName')
+  const tool = text(body, 'tool') || null
+  if (!EMAIL.test(email)) return { ok: false, status: 400, message: 'Enter a valid email.' }
+  if (creating) {
+    const invalidName = validateName(displayName)
+    if (invalidName) return { ok: false, status: 400, message: invalidName }
+  }
+  const invalidPassword = validatePassword(password)
+  if (invalidPassword) return { ok: false, status: 400, message: invalidPassword }
+  if (tool && !/^[a-z0-9-]+$/.test(tool)) return { ok: false, status: 400, message: 'Unknown writing tool.' }
+  return { ok: true, email, password, displayName, tool }
+}
+
+function validateName(displayName: string): string | null {
+  if (!displayName) return 'Enter the name readers will see.'
+  if (displayName.length > 40) return 'Keep the name to 40 characters.'
+  return null
+}
+
+function validatePassword(password: string): string | null {
+  if (password.length < 12) return 'Use at least 12 characters.'
+  if (!/[a-z]/.test(password) || !/[A-Z]/.test(password) || !/[0-9]/.test(password) || !/[^A-Za-z0-9]/.test(password)) {
+    return 'Use upper and lower case, a number, and a symbol.'
+  }
+  return null
+}
+
+function snapshotResponse(
+  snapshot: { revision: string; updatedAt: string; body: Record<string, unknown> },
+  status: number,
+): Response {
+  const response = json(
+    { snapshot: snapshot.body, revision: snapshot.revision, updatedAt: snapshot.updatedAt },
+    status,
+  )
+  response.headers.set('ETag', `"${snapshot.revision}"`)
+  return response
+}
+
+async function readJson(request: AccountRequest): Promise<Record<string, unknown>> {
+  try {
+    const body = await request.json()
+    if (body && typeof body === 'object' && !Array.isArray(body)) return body as Record<string, unknown>
+  } catch {
+    return {}
+  }
+  return {}
+}
+
+function text(body: Record<string, unknown>, key: string): string {
+  const value = body[key]
+  return typeof value === 'string' ? value.trim() : ''
+}
+
+function bearer(request: AccountRequest): string | null {
+  const header = request.headers.get('authorization') ?? ''
+  const match = /^Bearer\s+(\S+)$/i.exec(header)
+  return match?.[1] ?? null
+}
+
+function json(body: unknown, status = 200): Response {
+  return new Response(JSON.stringify(body), {
+    status,
+    headers: { 'Content-Type': 'application/json; charset=utf-8' },
+  })
+}
+
+function cors(response: Response): Response {
+  const headers = new Headers(response.headers)
+  headers.set('Access-Control-Allow-Origin', '*')
+  headers.set('Access-Control-Allow-Headers', 'Authorization, Content-Type, If-Match')
+  headers.set('Access-Control-Allow-Methods', 'GET, POST, PUT, PATCH, OPTIONS')
+  headers.set('Access-Control-Expose-Headers', 'ETag')
+  return new Response(response.body, { status: response.status, headers })
+}
+
+export { SNAPSHOT_BYTE_LIMIT }
