{
  "name": "humanuscript",
  "productName": "HuManuScript",
  "private": true,
  "version": "0.1.0",
  "description": "Keyboard-sealed manuscript editor on the Speak Fiction block model.",
  "author": "HuManuScript",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 47321 --strictPort",
    "dev:electron": "concurrently -k \"vite --host 127.0.0.1 --port 47321 --strictPort\" \"wait-on tcp:127.0.0.1:47321 && cross-env ELECTRON=1 electron .\"",
    "build": "tsc -b && vite build",
    "build:electron": "cross-env ELECTRON=1 tsc -b && cross-env ELECTRON=1 vite build && node scripts/bundle-updater.cjs",
    "make:icns": "node scripts/make-icns.cjs",
    "pack:mac": "node scripts/pack-mac.cjs",
    "pack:mac:all": "node scripts/pack-mac.cjs --all",
    "pack:mac:intel": "node scripts/pack-mac.cjs --intel",
    "pack:win": "node scripts/pack-win.cjs",
    "dispatch:pack-mac": "bash scripts/dispatch-pack-mac.sh",
    "test": "node --experimental-strip-types --test src/core/*.test.ts scripts/app-version.test.cjs electron/*.test.cjs",
    "lint": "oxlint",
    "preview": "vite preview --host 127.0.0.1 --port 47321 --strictPort"
  },
  "dependencies": {
    "@myriaddreamin/typst-ts-renderer": "0.7.0",
    "@myriaddreamin/typst-ts-web-compiler": "0.7.0",
    "@myriaddreamin/typst.ts": "0.7.0",
    "docx": "^9.11.0",
    "electron-updater": "^6.8.11",
    "harper.js": "^2.13.0",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^32.3.3",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.2",
    "oxlint": "^1.81.0",
    "playwright": "^1.64.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wait-on": "^8.0.5"
  }
}
