{
  "name": "humanuscript",
  "productName": "HuManuScript",
  "private": true,
  "version": "0.1.0",
  "description": "SlashConnect, a private two-person app for an adult long-distance dynamic. Electron, Vite, and React.",
  "author": "HuManuScript",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 47321 --strictPort",
    "dev:electron": "concurrently -k \"vite --host 127.0.0.1 --port 47321 --strictPort\" \"wait-on tcp:127.0.0.1:47321 && cross-env ELECTRON=1 electron .\"",
    "build": "tsc -b && vite build",
    "build:functions": "esbuild server/hosted.mjs --bundle --platform=node --format=esm --target=node22 --outfile=functions/lib/hosted.mjs",
    "firebase:emulate": "npm run build && npm run build:functions && npm --prefix functions install && npx --yes firebase-tools@15.35.0 emulators:start --project demo-slashconnect",
    "firebase:deploy": "npm --prefix functions install && npx --yes firebase-tools@15.35.0 deploy",
    "firebase:register": "node scripts/firebase-register.mjs",
    "native:build": "tsc -b && vite build --mode native",
    "native:sync": "npm run native:build && cap sync",
    "native:android": "npm run native:sync && cd android && ./gradlew assembleDebug",
    "native:ios": "npm run native:sync && cap open ios",
    "build:electron": "cross-env ELECTRON=1 tsc -b && cross-env ELECTRON=1 vite build && node scripts/bundle-updater.cjs",
    "make:icns": "node scripts/make-icns.cjs",
    "pack:mac": "node scripts/pack-mac.cjs",
    "pack:mac:all": "node scripts/pack-mac.cjs --all",
    "pack:mac:intel": "node scripts/pack-mac.cjs --intel",
    "pack:win": "node scripts/pack-win.cjs",
    "dispatch:pack-mac": "bash scripts/dispatch-pack-mac.sh",
    "test": "node --experimental-strip-types --test src/core/*.test.ts src/slash/*.test.ts scripts/*.test.cjs electron/*.test.cjs server/*.test.mjs",
    "lint": "oxlint",
    "preview": "vite preview --host 127.0.0.1 --port 47321 --strictPort"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@myriaddreamin/typst-ts-renderer": "0.7.0",
    "@myriaddreamin/typst-ts-web-compiler": "0.7.0",
    "@myriaddreamin/typst.ts": "0.7.0",
    "docx": "^9.11.0",
    "electron-updater": "^6.8.11",
    "firebase": "^13.2.0",
    "harper.js": "^2.13.0",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^32.3.3",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.2",
    "oxlint": "^1.81.0",
    "playwright": "^1.64.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wait-on": "^8.0.5"
  }
}
