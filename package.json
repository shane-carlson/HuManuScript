{
  "name": "humanuscript",
  "productName": "HuManuScript",
  "private": true,
  "version": "0.1.0",
  "description": "Keyboard-sealed manuscript editor on the Speak Fiction block model.",
  "author": "HuManuScript",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 47321 --strictPort",
    "dev:electron": "concurrently -k \"vite --host 127.0.0.1 --port 47321 --strictPort\" \"wait-on tcp:127.0.0.1:47321 && cross-env ELECTRON=1 electron .\"",
    "build": "tsc -b && vite build",
    "build:electron": "cross-env ELECTRON=1 tsc -b && cross-env ELECTRON=1 vite build",
    "pack:mac": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false npm run build:electron && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg --arm64 --x64",
    "test": "node --experimental-strip-types --test src/core/*.test.ts",
    "lint": "oxlint",
    "preview": "vite preview --host 127.0.0.1 --port 47321 --strictPort"
  },
  "build": {
    "appId": "com.humanuscript.app",
    "productName": "HuManuScript",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64", "x64"]
        }
      ],
      "category": "public.app-category.productivity",
      "artifactName": "HuManuScript-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "HuManuScript",
      "iconSize": 80
    }
  },
  "dependencies": {
    "docx": "^9.11.0",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^32.3.3",
    "electron-builder": "^25.1.8",
    "wait-on": "^8.0.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
